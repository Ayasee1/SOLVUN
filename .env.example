# Server
PORT=3000

# Postgres (Supabase). Leave empty to use the in-memory repositories.
# Direct connection:
DATABASE_URL=postgres://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
# Session pooler (use this if the direct connection is unreachable, e.g. IPv4-only networks):
# DATABASE_URL=postgres://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# Admin API key for /admin endpoints (sent as the X-API-Key header).
# Generate one with: openssl rand -hex 24
ADMIN_API_KEY=

# Midtrans (dashboard.midtrans.com -> Settings -> Access Keys)
# Never commit the real key. Copy this file to .env and fill it in.
# Client key diambil dari dashboard Midtrans (Settings -> Access Keys).
# Key ini publik (dipakai browser untuk Snap.js popup).
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_ENV=sandbox

# Snap payment window in minutes. 0 = Midtrans default (24h).
# Set a small value (e.g. 15) so it matches the order sweeper timeout.
MIDTRANS_EXPIRY_MINUTES=15

# Email: Resend wins when set, then SMTP, otherwise emails are only logged.
# Testing without a verified domain: from=onboarding@resend.dev can only send
# to the email address registered on your Resend account.
RESEND_API_KEY=
MAIL_FROM=Golearn Store <no-reply@golearn.local>

# SMTP alternative (e.g. Mailtrap): used when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Shipping (Biteship). Empty key disables shipping rates.
# biteship_test. prefix = test mode, biteship_live. = live.
# Provider ongkir: biteship | flat | disabled (kosong = auto)
# - flat: ongkir tetap dari SHIPPING_FLAT_RATES (buat development, tanpa biaya)
# - biteship: butuh BITESHIP_API_KEY (dan saldo Biteship)
SHIPPING_PROVIDER=flat
SHIPPING_FLAT_RATES=Reguler:15000,Express:25000
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com

# Store warehouse origin (used as the shipment origin)
STORE_ORIGIN_POSTAL_CODE=
STORE_ORIGIN_LAT=
STORE_ORIGIN_LON=
STORE_ORIGIN_CONTACT=Golearn Store
STORE_ORIGIN_PHONE=
STORE_ORIGIN_ADDRESS=
# courier pickup (default) or drop_off
STORE_COLLECTION_METHOD=pickup

# Public base URL of the store (payment redirect + email links)
STORE_BASE_URL=http://localhost:3000

# Allowed browser origins (comma separated). Empty = "*" (dev only).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
